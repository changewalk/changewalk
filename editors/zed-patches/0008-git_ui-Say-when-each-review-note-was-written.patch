+/// When a note was written, worded for showing beside its author: "Today
+/// at" or "Yesterday at" and the time, else the date and the time, in the
+/// user's own time zone and format.
+fn posted_at_label(created_at: Option<&str>) -> Option<SharedString> {
+    let local_offset = time::UtcOffset::current_local_offset().unwrap_or(time::UtcOffset::UTC);
+    posted_at_label_at(created_at?, time::OffsetDateTime::now_utc(), local_offset)
+}
+
+/// [`posted_at_label`] for a note read at `now` in the time zone `offset`.
+/// Nothing for a timestamp that is not one of GitLab's.
+fn posted_at_label_at(
+    created_at: &str,
+    now: time::OffsetDateTime,
+    offset: time::UtcOffset,
+) -> Option<SharedString> {
+    let posted =
+        time::OffsetDateTime::parse(created_at, &time::format_description::well_known::Rfc3339)
+            .ok()?;
+    Some(
+        time_format::format_localized_timestamp(
+            posted,
+            now,
+            offset,
+            time_format::TimestampFormat::EnhancedAbsolute,
+        )
+        .into(),
+    )
+}
+
 /// Seconds since the Unix epoch for one of GitLab's ISO 8601 timestamps.
 fn parse_timestamp(text: &str) -> Option<i64> {
     time::OffsetDateTime::parse(text, &time::format_description::well_known::Rfc3339)
@@ -4402,3 +4461,38 @@ fn tree_sort_path(repo_path: &RelPath) -> Arc<RelPath> {
         .map(|path| path.into_arc())
         .unwrap_or_else(|_| repo_path.into_arc())
 }
