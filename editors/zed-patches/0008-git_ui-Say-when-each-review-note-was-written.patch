+#[cfg(test)]
+mod tests {
+    use super::*;
+    use time::macros::{datetime, offset};
+
+    /// A note's time is worded by the day it was written on in the reader's
+    /// own time zone, which is not always the day GitLab's UTC stamp names.
+    #[test]
+    fn a_note_time_is_worded_by_the_readers_own_day() {
+        let now = datetime!(2026-11-11 12:00 UTC);
+        let label = |created_at: &str, offset| {
+            posted_at_label_at(created_at, now, offset).map(|label| label.to_string())
+        };
+
+        assert_eq!(label("not a time", offset!(UTC)), None);
+        // The fallback wording off macOS and Windows has no day in words.
+        if cfg!(any(target_os = "macos", target_os = "windows")) {
+            let today = label("2026-11-11T09:53:00.000Z", offset!(UTC)).unwrap();
+            assert!(today.starts_with("Today at "), "{today}");
+            let yesterday = label("2026-11-10T23:30:00.000Z", offset!(UTC)).unwrap();
+            assert!(yesterday.starts_with("Yesterday at "), "{yesterday}");
+            // Half past eleven at night in UTC is already today two hours east.
+            let east = label("2026-11-10T23:30:00.000Z", offset!(+2)).unwrap();
+            assert!(east.starts_with("Today at "), "{east}");
+            let older = label("2026-11-03T13:41:00.000Z", offset!(UTC)).unwrap();
+            assert!(
+                !older.starts_with("Today") && !older.starts_with("Yesterday"),
+                "{older}"
+            );
+        } else {
+            assert!(label("2026-11-11T09:53:00.000Z", offset!(UTC)).is_some());
+        }
+    }
+}
