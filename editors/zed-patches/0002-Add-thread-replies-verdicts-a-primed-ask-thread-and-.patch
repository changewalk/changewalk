+            editor
+        });
+        let focus_handle = editor.focus_handle(cx);
+        window.focus(&focus_handle, cx);
+        self.review_summary = Some(ReviewSummary {
+            editor,
+            drafting: false,
+            posting: false,
+        });
+        cx.notify();
+    }
