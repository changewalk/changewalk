     /// Fetches what the header shows besides the description: the linked
     /// issues, who approved, and the user's own reviewer state. Each is
     /// optional, so a failure only logs.
+    /// Fetches the pictures the description links to among the project's
+    /// uploads. Those links need the user's login, so the markdown cannot
+    /// load them by itself; each is fetched once through `glab`, kept in
+    /// the review cache, and drawn from its file as it arrives.
+    fn load_description_images(&mut self, cx: &mut Context<Self>) {
+        const CONCURRENT_DOWNLOADS: usize = 4;
+
+        let Some(work_dir) = self.work_dir(cx) else {
+            return;
+        };
+        let Some(text) = self
+            .merge_request
+            .as_ref()
+            .and_then(|header| header.description_text.as_deref())
+        else {
+            return;
+        };
+        let uploads: Vec<Upload> = Upload::all_in(text)
+            .into_iter()
+            .filter(Upload::is_image)
+            .collect();
+        if uploads.is_empty() {
+            return;
+        }
+        let (fetched_tx, mut fetched_rx) = futures::channel::mpsc::unbounded();
+        let fetch = cx.background_spawn(async move {
+            review_cache::prune_uploads();
+            stream::iter(uploads)
+                .for_each_concurrent(CONCURRENT_DOWNLOADS, |upload| {
+                    let work_dir = work_dir.clone();
+                    let fetched_tx = fetched_tx.clone();
+                    async move {
+                        let file = review_cache::upload_file(&upload.cache_file_name());
+                        let fetched = if file.exists() {
+                            Ok(())
+                        } else {
+                            gitlab_review::download_upload(&work_dir, &upload, &file).await
+                        };
+                        fetched_tx.unbounded_send((upload, file, fetched)).ok();
+                    }
+                })
+                .await;
+        });
+        self._description_images_task = Some(cx.spawn(async move |this, cx| {
+            let _fetch = fetch;
+            while let Some((upload, file, fetched)) = fetched_rx.next().await {
+                if let Err(error) = fetched {
+                    log::warn!(
+                        "could not fetch the picture {} of the description: {error:#}",
+                        upload.file_name
+                    );
+                    continue;
+                }
+                let shown = this.update(cx, |this, cx| {
+                    if let Some(header) = this.merge_request.as_mut() {
+                        Arc::make_mut(&mut header.description_images).insert(upload, file.into());
+                        cx.notify();
+                    }
+                });
+                if shown.is_err() {
+                    break;
+                }
+            }
+        }));
+    }
