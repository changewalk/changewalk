+/// What to draw for an image link in a description. An upload of the
+/// project is drawn from the file it was fetched to; while it is on its
+/// way there is nothing to draw, and the markdown shows the link's text.
+/// Any other picture on the web is loaded from its address.
+fn description_image(
+    link: &str,
+    project_url: Option<&str>,
+    uploads: &HashMap<Upload, Arc<Path>>,
+) -> Option<ImageSource> {
+    if let Some(upload) = Upload::from_link(link, project_url) {
+        return uploads
+            .get(&upload)
+            .map(|file| ImageSource::from(file.clone()));
+    }
+    (link.starts_with("https://") || link.starts_with("http://"))
+        .then(|| ImageSource::Resource(Resource::Uri(SharedUri::from(link.to_string()))))
+}
