+/// A file uploaded to the project, as a description or a note links to it.
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct Upload {
+    /// The random folder GitLab keeps the file under.
+    pub secret: String,
+    /// The file's name as the link writes it, percent-encoded if the link is.
+    pub file_name: String,
+}
+
+/// What a link to an upload starts with, after the project's address.
+const UPLOADS_PREFIX: &str = "/uploads/";
+
+impl Upload {
+    /// The upload `link` points at. GitLab writes a link to a file of the
+    /// same project as `/uploads/<secret>/<name>`; the same under the
+    /// project's own address counts too. Any other link is not an upload.
+    pub fn from_link(link: &str, project_url: Option<&str>) -> Option<Self> {
+        let path = project_url
+            .and_then(|project_url| link.strip_prefix(project_url.trim_end_matches('/')))
+            .unwrap_or(link);
+        let (upload, length) = Self::parse(path.strip_prefix(UPLOADS_PREFIX)?)?;
+        (UPLOADS_PREFIX.len() + length == path.len()).then_some(upload)
+    }
+
+    /// Every upload linked in `text`, each once, in the order they appear.
+    pub fn all_in(text: &str) -> Vec<Self> {
+        let mut uploads = Vec::new();
+        let mut rest = text;
+        while let Some(start) = rest.find(UPLOADS_PREFIX) {
+            rest = &rest[start + UPLOADS_PREFIX.len()..];
+            if let Some((upload, length)) = Self::parse(rest) {
+                rest = &rest[length..];
+                if !uploads.contains(&upload) {
+                    uploads.push(upload);
+                }
+            }
+        }
+        uploads
+    }
+
+    /// Reads `<secret>/<name>` off the front of `text`, and says how much
+    /// of it that was. The name ends where a markdown or HTML link would.
+    fn parse(text: &str) -> Option<(Self, usize)> {
+        let (secret, after) = text.split_once('/')?;
+        if secret.len() < 16 || !secret.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+            return None;
+        }
+        let end = after
+            .find(|character: char| {
+                character.is_whitespace() || matches!(character, ')' | '"' | '\'' | '<' | '>')
+            })
+            .unwrap_or(after.len());
+        let file_name = &after[..end];
+        if file_name.is_empty() || file_name.contains('/') || matches!(file_name, "." | "..") {
+            return None;
+        }
+        Some((
+            Self {
+                secret: secret.to_string(),
+                file_name: file_name.to_string(),
+            },
+            secret.len() + 1 + end,
+        ))
+    }
+
+    /// Whether the file is a picture, going by its name. GitLab shows a
+    /// video the same way in markdown, which cannot be drawn here.
+    pub fn is_image(&self) -> bool {
+        let extension = self
+            .file_name
+            .rsplit_once('.')
+            .map(|(_, extension)| extension.to_ascii_lowercase());
+        matches!(
+            extension.as_deref(),
+            Some("png" | "jpg" | "jpeg" | "gif" | "webp" | "bmp" | "svg")
+        )
+    }
+
+    /// A name for the fetched file that is safe on every file system and
+    /// keeps the extension, which says what kind of picture it is.
+    pub fn cache_file_name(&self) -> String {
+        let name: String = self
+            .file_name
+            .chars()
+            .map(|character| {
+                if character.is_ascii_alphanumeric() || matches!(character, '.' | '-' | '_') {
+                    character
+                } else {
+                    '_'
+                }
+            })
+            .collect();
+        format!("{}-{name}", self.secret)
+    }
+}
+
+/// Fetches `upload` into `file`. A link to an upload needs the user's
+/// login, which `glab` has. The bytes go to a neighbouring file first, so a
+/// half-written one is never found under the final name.
+pub async fn download_upload(work_dir: &Path, upload: &Upload, file: &Path) -> Result<()> {
+    let endpoint = format!(
+        "projects/:id/uploads/{}/{}",
+        upload.secret, upload.file_name
+    );
+    let bytes = glab_api_bytes(work_dir, "GET", &endpoint, None).await?;
+    let folder = file.parent().context("the upload has no folder to go in")?;
+    std::fs::create_dir_all(folder).with_context(|| format!("creating {}", folder.display()))?;
+    let partial = folder.join(format!("{}.part", upload.cache_file_name()));
+    std::fs::write(&partial, bytes).with_context(|| format!("writing {}", partial.display()))?;
+    std::fs::rename(&partial, file).with_context(|| format!("writing {}", file.display()))
+}
