+    /// A picture in the description that is one of the project's uploads
+    /// is drawn from the file it was fetched to, in a table cell as GitLab
+    /// lays screenshots out. One not fetched leaves its link's text.
+    #[gpui::test]
+    async fn test_description_draws_fetched_uploads(cx: &mut TestAppContext) {
+        use crate::gitlab_review::Upload;
+
+        // A 40 by 20 PNG, all one colour.
+        const PICTURE: &[u8] = &[
+            137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 0, 40, 0, 0, 0, 20,
+            8, 2, 0, 0, 0, 112, 36, 232, 236, 0, 0, 0, 36, 73, 68, 65, 84, 120, 218, 99, 56, 97,
+            99, 51, 32, 136, 97, 212, 226, 81, 139, 71, 45, 30, 181, 120, 212, 226, 81, 139, 71,
+            45, 30, 181, 120, 228, 88, 12, 0, 100, 11, 232, 46, 205, 155, 202, 211, 0, 0, 0, 0, 73,
+            69, 78, 68, 174, 66, 96, 130,
+        ];
+
+        init_test(cx);
+
+        let fs = FakeFs::new(cx.executor());
+        fs.insert_tree(
+            path!("/project"),
+            json!({
+                ".git": {},
+                "a.txt": "C",
+            }),
+        )
+        .await;
+        let project = Project::test(fs.clone(), [path!("/project").as_ref()], cx).await;
+        let (multi_workspace, cx) =
+            cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+        let workspace = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+        let branch_diff = cx
+            .update(|window, cx| {
+                BranchDiff::new_with_default_branch(project.clone(), workspace.clone(), window, cx)
+            })
+            .await
+            .unwrap();
+        workspace.update_in(cx, |workspace, window, cx| {
+            workspace.add_item_to_active_pane(
+                Box::new(branch_diff.clone()),
+                None,
+                true,
+                window,
+                cx,
+            );
+        });
+        fs.set_head_for_repo(
+            Path::new(path!("/project/.git")),
+            &[("a.txt", "B".into())],
+            "sha",
+        );
+        fs.set_merge_base_content_for_repo(
+            Path::new(path!("/project/.git")),
+            &[("a.txt", "A".into())],
+        );
+        cx.run_until_parked();
+
+        let folder = std::env::temp_dir().join(format!("zed-review-test-{}", std::process::id()));
+        std::fs::create_dir_all(&folder).unwrap();
+        let file = folder.join("before.png");
+        std::fs::write(&file, PICTURE).unwrap();
+        let secret = "d2e7a29c38a866c962c5cab82b22f0c9";
+        let text = format!(
+            "| Before | After |\n|---|---|\n\
+             | ![before](/uploads/{secret}/before.png) | ![after](/uploads/{secret}/after.png) |\n"
+        );
+        // The markdown names each picture it draws by where its link starts.
+        let drawn = |link: &str| -> &'static str {
+            let start = text.find(link).unwrap();
+            Box::leak(format!("markdown_image_{start}").into_boxed_str())
+        };
+
+        let diff = branch_diff.read_with(cx, |branch_diff, _| branch_diff.diff.clone());
+        diff.update(cx, |diff, cx| {
+            diff.show_merge_request_for_test(cx);
+            diff.show_description_for_test(
+                &text,
+                vec![(
+                    Upload {
+                        secret: secret.into(),
+                        file_name: "before.png".into(),
+                    },
+                    file,
+                )],
+                cx,
+            );
+        });
+        cx.run_until_parked();
+
+        let before = cx
+            .debug_bounds(drawn("![before]"))
+            .expect("the fetched picture is drawn");
+        // The picture's own 40 by 20 and its margin: the text that stands
+        // in for a picture that failed to load would be far wider.
+        assert!(
+            before.size.width >= px(40.) && before.size.width < px(50.),
+            "{before:?}"
+        );
+        assert!(
+            before.size.height >= px(20.) && before.size.height < px(30.),
+            "{before:?}"
+        );
+        assert!(cx.debug_bounds(drawn("![after]")).is_none());
+
+        std::fs::remove_dir_all(&folder).ok();
+    }
