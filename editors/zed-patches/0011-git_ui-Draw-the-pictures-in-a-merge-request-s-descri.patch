+/// How long a fetched upload is kept. One still wanted after that is
+/// fetched again.
+const UPLOADS_KEPT_FOR: std::time::Duration = std::time::Duration::from_secs(30 * 24 * 60 * 60);
+
+fn uploads_dir() -> PathBuf {
+    cache_dir().join("uploads")
+}
+
+/// Where the upload with this cache name is kept once fetched.
+pub(crate) fn upload_file(cache_file_name: &str) -> PathBuf {
+    uploads_dir().join(cache_file_name)
+}
+
+/// Removes the uploads fetched longer ago than they are kept for, so the
+/// folder does not grow with every merge request ever read.
+pub(crate) fn prune_uploads() {
+    let Ok(entries) = std::fs::read_dir(uploads_dir()) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let old = entry
+            .metadata()
+            .and_then(|metadata| metadata.modified())
+            .ok()
+            .and_then(|modified| modified.elapsed().ok())
+            .is_some_and(|age| age > UPLOADS_KEPT_FOR);
+        if old {
+            std::fs::remove_file(entry.path()).ok();
+        }
+    }
+}
