+    fn run_general_thread_request<T: 'static>(
+        &mut self,
+        request: Task<Result<T>>,
+        failure: &'static str,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+        on_success: impl FnOnce(&mut Self, T, &mut Window, &mut Context<Self>) + 'static,
+    ) {
+        self.general_thread_busy = true;
+        cx.notify();
+        self._general_thread_task = Some(cx.spawn_in(window, async move |this, cx| {
+            let result = request.await;
+            this.update_in(cx, |this, window, cx| {
+                this.general_thread_busy = false;
+                match result {
+                    Ok(value) => on_success(this, value, window, cx),
+                    Err(error) => this.show_workspace_error(format!("{failure}: {error:#}"), cx),
+                }
+                cx.notify();
+            })
+            .ok();
+        }));
