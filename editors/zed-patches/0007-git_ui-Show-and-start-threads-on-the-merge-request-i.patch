+    /// The newest threads are on the last page, so stopping at the first
+    /// would hide exactly the ones just written.
+    #[test]
+    fn a_listing_is_read_to_its_last_page() {
+        let read = |total: usize| {
+            let asked = std::cell::RefCell::new(Vec::new());
+            let items = futures::executor::block_on(read_every_page(3, |page| {
+                asked.borrow_mut().push(page);
+                let start = (page - 1) * 3;
+                async move { Ok((start..total.min(start + 3)).collect::<Vec<usize>>()) }
+            }))
+            .unwrap();
+            (items, asked.into_inner())
+        };
+
+        assert_eq!(read(7), ((0..7).collect::<Vec<_>>(), vec![1, 2, 3]));
+        assert_eq!(read(2), (vec![0, 1], vec![1]));
+        // A last page that is exactly full needs one more look.
+        assert_eq!(read(6), ((0..6).collect::<Vec<_>>(), vec![1, 2, 3]));
+        assert_eq!(read(0), (Vec::new(), vec![1]));
+
+        let failed: Result<Vec<usize>> =
+            futures::executor::block_on(read_every_page(3, |_| async { bail!("offline") }));
+        assert!(failed.is_err());
+    }
