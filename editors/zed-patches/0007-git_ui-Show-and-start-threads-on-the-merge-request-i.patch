+            .map(|workspace| workspace.read(cx).project().read(cx).languages().clone());
+        let text: SharedString = note.body.clone().into();
+        let markdown = cx.new(|cx| {
+            // Notes carry code blocks, diagrams, and HTML details blocks,
+            // which the defaults leave as text.
+            Markdown::new_with_options(
+                text,
+                languages,
+                None,
+                MarkdownOptions {
+                    parse_html: true,
+                    render_mermaid_diagrams: true,
+                    ..Default::default()
+                },
+                cx,
+            )
+        });
+        GeneralNote {
+            author: note.author.into(),
+            body: note.body,
