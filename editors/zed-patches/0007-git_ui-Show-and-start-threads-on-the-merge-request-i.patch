+    /// Threads on the merge request itself have no line to sit under, so
+    /// they show under the description: folded to a line, opened by a
+    /// click, and kept as they are on screen across a refresh.
+    #[gpui::test]
+    async fn test_merge_request_threads_show_under_the_description(cx: &mut TestAppContext) {
+        use crate::gitlab_review::{GeneralDiscussion, RemoteNote};
+
+        init_test(cx);
+
+        let fs = FakeFs::new(cx.executor());
+        fs.insert_tree(
+            path!("/project"),
+            json!({
+                ".git": {},
+                "a.txt": "C",
+            }),
+        )
+        .await;
+        let project = Project::test(fs.clone(), [path!("/project").as_ref()], cx).await;
+        let (multi_workspace, cx) =
+            cx.add_window_view(|window, cx| MultiWorkspace::test_new(project.clone(), window, cx));
+        let workspace = multi_workspace.read_with(cx, |mw, _| mw.workspace().clone());
+        let branch_diff = cx
+            .update(|window, cx| {
+                BranchDiff::new_with_default_branch(project.clone(), workspace.clone(), window, cx)
+            })
+            .await
+            .unwrap();
+        workspace.update_in(cx, |workspace, window, cx| {
+            workspace.add_item_to_active_pane(
+                Box::new(branch_diff.clone()),
+                None,
+                true,
+                window,
+                cx,
+            );
+        });
+        fs.set_head_for_repo(
+            Path::new(path!("/project/.git")),
+            &[("a.txt", "B".into())],
+            "sha",
+        );
+        fs.set_merge_base_content_for_repo(
+            Path::new(path!("/project/.git")),
+            &[("a.txt", "A".into())],
+        );
+        cx.run_until_parked();
+
+        let note = |author: &str, body: &str| RemoteNote {
+            id: None,
+            author: author.into(),
+            body: body.into(),
+        };
+        let open_thread = |notes: Vec<RemoteNote>| GeneralDiscussion {
+            id: "open".into(),
+            resolved: false,
+            created_at: None,
+            notes,
+        };
+        let resolved_thread = || GeneralDiscussion {
+            id: "resolved".into(),
+            resolved: true,
+            created_at: None,
+            notes: vec![note("Bob", "Is there a recording?")],
+        };
+
+        let diff = branch_diff.read_with(cx, |branch_diff, _| branch_diff.diff.clone());
+        diff.update(cx, |diff, cx| {
+            diff.show_merge_request_for_test(cx);
+            // Before any thread is known there is nothing to show.
+            assert_eq!(diff.general_thread_counts(), None);
+            diff.apply_general_threads(
+                vec![
+                    open_thread(vec![note("Ada", "The after video looks the same to me.")]),
+                    resolved_thread(),
+                ],
+                cx,
+            );
+        });
+        cx.run_until_parked();
+
+        // Both threads are drawn, the resolved one included, each on a line.
+        let section = cx.debug_bounds("merge-request-threads").unwrap();
+        let open_line = cx.debug_bounds("general-thread-0").unwrap();
+        let resolved_line = cx.debug_bounds("general-thread-1").unwrap();
+        assert!(section.size.height > px(0.));
+        assert!(resolved_line.origin.y > open_line.origin.y);
+        assert!(cx.debug_bounds("general-thread-body-0").is_none());
+        assert_eq!(
+            diff.read_with(cx, |diff, _| diff.general_thread_counts()),
+            Some(("1 open general thread".to_string(), Color::Warning))
+        );
+
+        // A click on the line opens the thread.
+        cx.simulate_click(open_line.center(), gpui::Modifiers::none());
+        cx.run_until_parked();
+        assert!(cx.debug_bounds("general-thread-body-0").is_some());
+        assert!(cx.debug_bounds("general-thread-body-1").is_none());
+
+        // A refresh brings a reply and keeps the thread open; the thread
+        // GitLab no longer lists goes.
+        diff.update(cx, |diff, cx| {
+            diff.apply_general_threads(
+                vec![open_thread(vec![
+                    note("Ada", "The after video looks the same to me."),
+                    note("Bob", "Uploaded the right one."),
+                ])],
+                cx,
+            );
+        });
+        cx.run_until_parked();
+        assert_eq!(
+            diff.read_with(cx, |diff, _| diff.general_threads_for_test()),
+            vec![(
+                "open".to_string(),
+                false,
+                true,
+                vec![
+                    "The after video looks the same to me.".to_string(),
+                    "Uploaded the right one.".to_string()
+                ]
+            )]
+        );
+        assert!(cx.debug_bounds("general-thread-body-0").is_some());
+        assert!(cx.debug_bounds("general-thread-1").is_none());
+
+        // With every thread resolved the title row says so, quietly.
+        diff.update(cx, |diff, cx| {
+            diff.apply_general_threads(vec![resolved_thread()], cx);
+        });
+        assert_eq!(
+            diff.read_with(cx, |diff, _| diff.general_thread_counts()),
+            Some(("1 general thread, resolved".to_string(), Color::Muted))
+        );
+
+        // The box for a new thread opens under the threads, and with the
+        // description folded away the threads fold with it.
+        assert!(cx.debug_bounds("general-thread-new").is_none());
+        diff.update_in(cx, |diff, window, cx| diff.start_general_thread(window, cx));
+        cx.run_until_parked();
+        assert!(cx.debug_bounds("general-thread-new").is_some());
+        diff.update(cx, |diff, cx| diff.toggle_merge_request_description(cx));
+        cx.run_until_parked();
+        assert!(cx.debug_bounds("merge-request-threads").is_none());
+        // Starting a thread unfolds it again, since the box is under it.
+        diff.update_in(cx, |diff, window, cx| diff.start_general_thread(window, cx));
+        cx.run_until_parked();
+        assert!(cx.debug_bounds("general-thread-new").is_some());
+    }
