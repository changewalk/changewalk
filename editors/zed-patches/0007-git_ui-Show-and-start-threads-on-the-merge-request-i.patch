+    /// The thread as GitLab has it, carrying over what `shown` had on
+    /// screen. A note whose text did not change keeps its parsed markdown,
+    /// so a selection in it survives the refresh.
+    fn general_thread(
+        &self,
+        discussion: GeneralDiscussion,
+        shown: Option<GeneralThread>,
+        since_last_review: bool,
+        cx: &mut Context<Self>,
+    ) -> GeneralThread {
+        let (expanded, reply, shown_notes) = match shown {
+            Some(shown) => (shown.expanded, shown.reply, shown.notes),
+            None => (false, None, Vec::new()),
+        };
+        let notes = discussion
+            .notes
+            .into_iter()
+            .enumerate()
+            .map(|(index, note)| match shown_notes.get(index) {
+                Some(shown)
+                    if shown.body == note.body && shown.author.as_ref() == note.author.as_str() =>
+                {
+                    shown.clone()
+                }
+                _ => self.general_note(note, cx),
+            })
+            .collect();
+        GeneralThread {
+            discussion_id: discussion.id,
+            resolved: discussion.resolved,
+            since_last_review,
+            notes,
+            expanded,
+            reply,
+        }
+    }
