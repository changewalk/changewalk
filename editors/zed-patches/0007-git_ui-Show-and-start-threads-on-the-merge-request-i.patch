+    /// Shows the threads on the merge request itself as GitLab has them. A
+    /// thread already shown stays open or folded as it was, and keeps the
+    /// reply being written on it.
+    pub(crate) fn apply_general_threads(
+        &mut self,
+        discussions: Vec<GeneralDiscussion>,
+        cx: &mut Context<Self>,
+    ) {
+        let last_review_at = self
+            .merge_request
+            .as_ref()
+            .and_then(|header| header.last_review.as_ref())
+            .map(|review| review.at);
+        let mut shown: HashMap<String, GeneralThread> = std::mem::take(&mut self.general_threads)
+            .into_iter()
+            .map(|thread| (thread.discussion_id.clone(), thread))
+            .collect();
+        let mut threads = Vec::with_capacity(discussions.len());
+        for discussion in discussions {
+            let since_last_review = last_review_at.is_some_and(|at| {
+                discussion
+                    .created_at
+                    .as_deref()
+                    .and_then(parse_timestamp)
+                    .is_some_and(|created| created > at)
+            });
+            let shown = shown.remove(&discussion.id);
+            threads.push(self.general_thread(discussion, shown, since_last_review, cx));
+        }
+        self.general_threads = threads;
+        cx.notify();
+    }
