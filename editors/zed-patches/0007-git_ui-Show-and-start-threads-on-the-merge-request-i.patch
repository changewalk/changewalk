+    /// One thread on the merge request itself: a line saying who opened it,
+    /// its state and its first words, and under it, when open, the notes
+    /// with the reply and resolve buttons.
+    fn render_general_thread(
+        &self,
+        index: usize,
+        thread: &GeneralThread,
+        markdown_style: &MarkdownStyle,
+        cx: &mut Context<Self>,
+    ) -> AnyElement {
+        let colors = cx.theme().colors();
+        let busy = self.general_thread_busy;
+        let resolved = thread.resolved;
+        let state_color = if resolved {
+            Color::Success
+        } else {
+            Color::Warning
+        };
+        let author = thread
+            .notes
+            .first()
+            .map(|note| note.author.clone())
+            .unwrap_or_default();
+        let preview = thread
+            .notes
+            .first()
+            .map(|note| preview_of(&note.body))
+            .unwrap_or_default();
+        let replies = thread.notes.len().saturating_sub(1);
+        let line = h_flex()
+            .id(("general-thread", index))
+            .debug_selector(|| format!("general-thread-{index}"))
+            .w_full()
+            .px_2()
+            .gap_1p5()
+            .items_center()
+            .rounded_md()
+            .cursor_pointer()
+            .overflow_hidden()
+            .hover(|style| style.bg(colors.ghost_element_hover))
+            .on_click(cx.listener({
+                let discussion_id = thread.discussion_id.clone();
+                move |this, _, _, cx| this.toggle_general_thread(&discussion_id, cx)
+            }))
+            .child(
+                Icon::new(if thread.expanded {
+                    IconName::ChevronDown
+                } else {
+                    IconName::ChevronRight
+                })
+                .size(IconSize::XSmall)
+                .color(Color::Muted),
+            )
+            .child(
+                Icon::new(if resolved {
+                    IconName::CheckDouble
+                } else {
+                    IconName::Chat
+                })
+                .size(IconSize::XSmall)
+                .color(state_color),
+            )
+            .child(Label::new(author).size(LabelSize::Small))
+            .child(
+                Label::new(if resolved { "Resolved" } else { "Open" })
+                    .size(LabelSize::XSmall)
+                    .color(state_color),
+            )
+            .when(thread.since_last_review, |el| {
+                el.child(
+                    Label::new("New")
+                        .size(LabelSize::XSmall)
+                        .color(Color::Accent),
+                )
+            })
+            .when(replies > 0, |el| {
+                el.child(
+                    Label::new(format!(
+                        "{replies} {}",
+                        if replies == 1 { "reply" } else { "replies" }
+                    ))
+                    .size(LabelSize::XSmall)
+                    .color(Color::Muted),
+                )
+            })
+            .when(!thread.expanded, |el| {
+                el.child(
+                    Label::new(preview)
+                        .size(LabelSize::Small)
+                        .color(Color::Muted)
+                        .truncate(),
+                )
+            });
+        if !thread.expanded {
+            return line.into_any_element();
+        }
+
+        let notes = thread.notes.iter().map(|note| {
+            v_flex()
+                .w_full()
+                .child(
+                    Label::new(note.author.clone())
+                        .size(LabelSize::Small)
+                        .weight(FontWeight::SEMIBOLD),
+                )
+                .child(div().w_full().text_sm().child(MarkdownElement::new(
+                    note.markdown.clone(),
+                    markdown_style.clone(),
+                )))
+        });
+        let buttons = match thread.reply.clone() {
+            Some(editor) => v_flex()
+                .w_full()
+                .gap_1()
+                .child(
+                    div()
+                        .w_full()
+                        .border_1()
+                        .border_color(colors.border)
+                        .rounded_md()
+                        .bg(colors.editor_background)
+                        .px_2()
+                        .py_1()
+                        .child(editor),
+                )
+                .child(
+                    h_flex()
+                        .gap_1()
+                        .child(
+                            Button::new(("general-thread-send", index), "Send")
+                                .style(ButtonStyle::Filled)
+                                .disabled(busy)
+                                .on_click(cx.listener({
+                                    let discussion_id = thread.discussion_id.clone();
+                                    move |this, _, window, cx| {
+                                        this.send_general_reply(discussion_id.clone(), window, cx)
+                                    }
+                                })),
+                        )
+                        .child(
+                            Button::new(("general-thread-cancel", index), "Cancel").on_click(
+                                cx.listener({
+                                    let discussion_id = thread.discussion_id.clone();
+                                    move |this, _, _, cx| {
+                                        this.cancel_general_reply(&discussion_id, cx)
+                                    }
+                                }),
+                            ),
+                        ),
+                ),
+            None => v_flex().w_full().child(
+                h_flex()
+                    .gap_1()
+                    .child(
+                        Button::new(("general-thread-reply", index), "Reply")
+                            .disabled(busy)
+                            .on_click(cx.listener({
