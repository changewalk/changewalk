+    /// How many threads are on the merge request itself, for its title row.
+    pub(crate) fn general_thread_counts(&self) -> Option<(String, Color)> {
+        let total = self.general_threads.len();
+        let open = self
+            .general_threads
+            .iter()
+            .filter(|thread| !thread.resolved)
+            .count();
+        let threads = |count: usize| if count == 1 { "thread" } else { "threads" };
+        if total == 0 {
+            None
+        } else if open > 0 {
+            Some((
+                format!("{open} open general {}", threads(open)),
+                Color::Warning,
+            ))
+        } else {
+            Some((
+                format!("{total} general {}, resolved", threads(total)),
+                Color::Muted,
+            ))
+        }
+    }
+
+    /// The threads on the merge request itself, each folded to a line until
+    /// clicked, and the box for a new one.
+    fn render_general_threads(
+        &self,
+        window: &Window,
+        cx: &mut Context<Self>,
+    ) -> Option<AnyElement> {
+        if self.general_threads.is_empty() && self.new_general_thread.is_none() {
+            return None;
+        }
+        let markdown_style = editor::hover_markdown_style(window, cx);
+        let threads: Vec<AnyElement> = self
+            .general_threads
+            .iter()
+            .enumerate()
+            .map(|(index, thread)| self.render_general_thread(index, thread, &markdown_style, cx))
+            .collect();
+        let busy = self.general_thread_busy;
+        let colors = cx.theme().colors();
+        let new_thread = self.new_general_thread.clone().map(|editor| {
+            v_flex()
+                .w_full()
+                .debug_selector(|| "general-thread-new".into())
+                .gap_1()
+                .px_2()
+                .py_1()
+                .child(
+                    Label::new(if busy {
+                        "Sending to GitLab…"
+                    } else {
+                        "New thread on the merge request. It stays open until it is resolved."
+                    })
+                    .size(LabelSize::Small)
+                    .color(Color::Muted),
+                )
+                .child(
+                    div()
+                        .w_full()
+                        .border_1()
+                        .border_color(colors.border)
+                        .rounded_md()
+                        .bg(colors.editor_background)
+                        .px_2()
+                        .py_1()
+                        .child(editor),
+                )
+                .child(
+                    h_flex()
+                        .w_full()
+                        .gap_1()
+                        .child(div().flex_1())
+                        .child(
+                            Button::new("general-thread-start", "Start Thread")
+                                .style(ButtonStyle::Filled)
+                                .disabled(busy)
+                                .on_click(cx.listener(|this, _, window, cx| {
+                                    this.post_general_thread(window, cx)
+                                })),
+                        )
+                        .child(
+                            IconButton::new("general-thread-close", IconName::Close)
+                                .icon_size(IconSize::Small)
+                                .tooltip(Tooltip::text("Close"))
+                                .on_click(
+                                    cx.listener(|this, _, _, cx| this.close_new_general_thread(cx)),
+                                ),
+                        ),
+                )
+        });
+        Some(
+            v_flex()
+                .w_full()
+                .debug_selector(|| "merge-request-threads".into())
+                .border_t_1()
+                .border_color(colors.border)
+                .py_1()
+                .when(!threads.is_empty(), |el| {
+                    el.child(
+                        v_flex()
+                            .id("merge-request-threads")
+                            .w_full()
+                            .max_h(GENERAL_THREADS_MAX_HEIGHT)
+                            .overflow_y_scroll()
+                            .px_1()
+                            .gap_0p5()
+                            .children(threads),
+                    )
+                })
+                .children(new_thread)
+                .into_any_element(),
+        )
+    }
