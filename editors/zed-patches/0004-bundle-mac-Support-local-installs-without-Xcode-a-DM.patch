From 32a6905b6f8535e1e4740c6e649aa780c021a6c4 Mon Sep 17 00:00:00 2001
From: Jack Walters <jackwalterswork@gmail.com>
Date: Fri, 6 Nov 2026 11:21:55 +0000
Subject: [PATCH 4/6] bundle-mac: Support local installs without Xcode, a DMG,
 or admin rights

Compile shaders at launch when the metal compiler is missing, skip DMG
creation after a local install (-i) since the bundle has already been
moved, and honour ZED_INSTALL_DIR so the bundle can go to ~/Applications.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 script/bundle-mac | 24 ++++++++++++++++++------
 1 file changed, 18 insertions(+), 6 deletions(-)

diff --git a/script/bundle-mac b/script/bundle-mac
index 6e1489f31a..9becad82f0 100755
--- a/script/bundle-mac
+++ b/script/bundle-mac
@@ -105,6 +105,13 @@ script/generate-licenses
 
 rustup target add $target_triple
 
+# Without full Xcode there is no `metal` compiler, so compile shaders at launch instead.
+if ! xcrun -sdk macosx --find metal >/dev/null 2>&1; then
+    echo "metal compiler not found; building with runtime shader compilation"
+    zed_features="${zed_features} --features gpui_platform/runtime_shaders"
+    remote_server_features="${remote_server_features} --features gpui_platform/runtime_shaders"
+fi
+
 echo "Compiling zed binaries"
 if [[ "$target_dir" = "release" ]]; then
     cargo --config .cargo/bundle-config.toml rustc ${build_flag} ${zed_features} --package zed --bin zed --target $target_triple -- -C 'link-arg=-Wl,-unexported_symbol,__R*'
@@ -249,18 +256,23 @@ function sign_app_binaries() {
     bundle_name=$(basename "$app_path")
 
     if [ "$local_install" = true ]; then
-        rm -rf "/Applications/$bundle_name"
-        mv "$app_path" "/Applications/$bundle_name"
-        echo "Installed application bundle: /Applications/$bundle_name"
+        # ZED_INSTALL_DIR lets non-admin users install into ~/Applications
+        install_dir="${ZED_INSTALL_DIR:-/Applications}"
+        mkdir -p "$install_dir"
+        rm -rf "$install_dir/$bundle_name"
+        mv "$app_path" "$install_dir/$bundle_name"
+        echo "Installed application bundle: $install_dir/$bundle_name"
         if [ "$open_result" = true ]; then
-            echo "Opening /Applications/$bundle_name"
-            open "/Applications/$bundle_name"
+            echo "Opening $install_dir/$bundle_name"
+            open "$install_dir/$bundle_name"
         fi
     elif [ "$open_result" = true ]; then
         open "$app_path"
     fi
 
-    if [[ "$target_dir" = "debug" ]]; then
+    if [ "$local_install" = true ]; then
+        echo "Local install - skipping DMG creation"
+    elif [[ "$target_dir" = "debug" ]]; then
         echo "Debug build detected - skipping DMG creation and signing"
         if [ "$local_install" = false ]; then
             echo "Created application bundle:"
