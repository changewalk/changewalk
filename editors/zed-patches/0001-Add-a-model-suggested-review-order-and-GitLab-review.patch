+    fn parse_git_review_url(&mut self, review_path: &str) -> Result<()> {
+        // Format: [/]?repo=<path>[&base=<ref>]
+        let query = review_path
+            .trim_start_matches('/')
+            .strip_prefix('?')
+            .context("invalid git review url: missing query string")?;
