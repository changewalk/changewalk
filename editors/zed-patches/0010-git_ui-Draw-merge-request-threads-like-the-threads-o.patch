+    resolved: bool,
+    author: &str,
+    place: &str,
+    replies: usize,
+    snippet: &str,
+) -> String {
+    let mark = if !posted {
+        "✎"
+    } else if resolved {
+        "✓"
+    } else {
+        "○"
+    };
+    let replies = if replies > 0 {
+        format!(" (+{replies})")
+    } else {
+        String::new()
+    };
+    format!("{mark} {author} · {place}{replies} — {snippet}")
+}
