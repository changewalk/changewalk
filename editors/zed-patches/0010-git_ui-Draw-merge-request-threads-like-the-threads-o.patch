+/// The prompt that asks for a reply to a thread on the merge request
+/// itself, which has no code of its own to show: only what the merge
+/// request is and what has been said so far.
+pub(crate) fn build_general_reply_prompt(
+    context: Option<&str>,
+    notes: &[ThreadNote],
+    own_name: &str,
+) -> String {
+    let mut prompt = include_str!("review_general_reply_prompt.txt").to_string();
+    append_context(&mut prompt, context);
+    writeln!(prompt, "\nYou write as {own_name}.").ok();
+    writeln!(prompt, "\nThe thread so far:").ok();
+    for note in notes {
+        writeln!(prompt, "\n{}:\n{}", note.author, note.body.trim()).ok();
+    }
+    prompt
+}
