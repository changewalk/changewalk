{
  "name": "changewalk",
  "displayName": "changewalk",
  "description": "Walk a GitLab or GitHub review in VS Code or Cursor.",
  "version": "0.1.0",
  "publisher": "changewalk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/changewalk/changewalk.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "changewalk.openReviewFromFile",
        "title": "changewalk: Open a review from a hand-off file"
      },
      {
        "command": "changewalk.postReview",
        "title": "changewalk: Post the review, with a verdict",
        "enablement": "changewalk.reviewing"
      },
      {
        "command": "changewalk.approve",
        "title": "changewalk: Approve the merge request",
        "enablement": "changewalk.reviewing"
      },
      {
        "command": "changewalk.requestChanges",
        "title": "changewalk: Request changes on the merge request",
        "enablement": "changewalk.reviewing"
      },
      {
        "command": "changewalk.markReviewed",
        "title": "changewalk: Mark the change as reviewed",
        "enablement": "changewalk.reviewing"
      },
      {
        "command": "changewalk.replyToThread",
        "title": "Reply",
        "enablement": "changewalk.reviewing"
      },
      {
        "command": "changewalk.toggleResolved",
        "title": "Resolve or reopen thread",
        "enablement": "changewalk.reviewing"
      },
      {
        "command": "changewalk.editComment",
        "title": "Edit comment",
        "icon": "$(edit)"
      },
      {
        "command": "changewalk.discardDraft",
        "title": "Discard draft",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "changewalk.replyToThread",
          "group": "inline@1",
          "when": "commentController == changewalk"
        },
        {
          "command": "changewalk.toggleResolved",
          "group": "inline@2",
          "when": "commentController == changewalk && commentThread =~ /remote/"
        },
        {
          "command": "changewalk.discardDraft",
          "group": "inline@3",
          "when": "commentController == changewalk && commentThread == draft"
        }
      ],
      "comments/comment/title": [
        {
          "command": "changewalk.editComment",
          "group": "inline@1",
          "when": "commentController == changewalk && comment =~ /^remote:/"
        }
      ],
      "commandPalette": [
        {
          "command": "changewalk.replyToThread",
          "when": "false"
        },
        {
          "command": "changewalk.toggleResolved",
          "when": "false"
        },
        {
          "command": "changewalk.editComment",
          "when": "false"
        },
        {
          "command": "changewalk.discardDraft",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test out-test/test/*.test.js",
    "test:integration": "node esbuild.js && tsc -p tsconfig.test.json && node out-test/test/runTest.js",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "vsce package --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.21.0",
    "mocha": "^12.0.3",
    "typescript": "^5.4.0"
  }
}
