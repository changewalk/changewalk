#!/usr/bin/env python3
"""Pick an open GitLab merge request you review, and open its ordered diff in Zed.

Usage: zed-review [--assignee] [REPO_DIR ...]

Lists the open merge requests where you are a reviewer (or the assignee with
--assignee) in each repository. Arrow keys move, Enter checks the branch out
and opens the branch diff in Zed with a suggested review order, `o` opens the
merge request in the browser, `q` quits.

Repositories come from the arguments, else $ZED_REVIEW_REPOS (colon separated),
else the current directory. $ZED_APP names the Zed app bundle to open.
"""

import curses
import json
import os
import subprocess
import sys
import textwrap
import time
import urllib.parse
from dataclasses import dataclass

ZED_APP = os.environ.get("ZED_APP", os.path.expanduser("~/Applications/Zed Dev.app"))


@dataclass
class MergeRequest:
    repo: str
    iid: int
    title: str
    author: str
    source_branch: str
    target_branch: str
    updated_at: str
    web_url: str
    description: str
    # How deep the merge request sits in a stack: 0 targets the default
    # branch, 1 targets another listed merge request's branch, and so on.
    depth: int = 0
    # True when the target is not the default branch, whether or not the
    # parent merge request is in the list.
    stacked: bool = False


def repositories(args):
    if args:
        return [os.path.abspath(arg) for arg in args]
    configured = os.environ.get("ZED_REVIEW_REPOS", "")
    if configured:
        return [os.path.expanduser(path) for path in configured.split(":") if path]
    return [os.getcwd()]


def project_path(repo):
    """The GitLab project path of the repository's origin, for the header."""
    result = subprocess.run(
        ["git", "remote", "get-url", "origin"], cwd=repo, capture_output=True, text=True
    )
    url = result.stdout.strip()
    path = url.split(":", 1)[-1] if url.startswith("git@") else url.split("/", 3)[-1]
    return path.removesuffix(".git") or os.path.basename(repo)


def run_glab(args, repo, attempts=3):
    """Run glab in the repository, retrying the brief network timeouts a
    mobile or flaky link causes, since glab gives up on a TLS handshake after
    ten seconds."""
    for attempt in range(1, attempts + 1):
        result = subprocess.run(["glab", *args], cwd=repo, capture_output=True, text=True)
        if result.returncode == 0:
            return result
        message = result.stderr.strip() or result.stdout.strip()
        if "timeout" not in message.lower() or attempt == attempts:
            raise RuntimeError(f"{repo}: {message}")
        print(f"glab timed out, retrying ({attempt}/{attempts - 1})...", file=sys.stderr)
        time.sleep(2)


def default_branch(repo):
    result = subprocess.run(
        ["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"],
        cwd=repo, capture_output=True, text=True,
    )
    name = result.stdout.strip().removeprefix("origin/")
    return name or "main"


def order_as_stacks(merge_requests, repo_default_branches):
    """Order the list so each merge request follows the one it is stacked on,
    newest stacks first, and mark the depth of each."""
    by_source = {(mr.repo, mr.source_branch): mr for mr in merge_requests}
    children = {}
    roots = []
    for mr in merge_requests:
        mr.stacked = mr.target_branch != repo_default_branches[mr.repo]
        parent = by_source.get((mr.repo, mr.target_branch))
        if parent is not None and parent is not mr:
            children.setdefault(parent.iid, []).append(mr)
        else:
            roots.append(mr)

    ordered = []

    def visit(mr, depth, seen):
        if mr.iid in seen:
            return
        seen.add(mr.iid)
        mr.depth = depth
        ordered.append(mr)
        for child in sorted(children.get(mr.iid, []), key=lambda c: c.updated_at, reverse=True):
            visit(child, depth + 1, seen)

    seen = set()
    for root in sorted(roots, key=lambda mr: mr.updated_at, reverse=True):
        visit(root, 0, seen)
    for mr in merge_requests:
        visit(mr, 0, seen)
    return ordered


def list_merge_requests(repo, role):
    result = run_glab(
        ["mr", "list", f"--{role}=@me", "--per-page", "100", "-F", "json"], repo
    )
    merge_requests = []
    for item in json.loads(result.stdout or "[]"):
        merge_requests.append(
            MergeRequest(
                repo=repo,
                iid=item["iid"],
                title=item["title"],
                author=item.get("author", {}).get("name", ""),
                source_branch=item["source_branch"],
                target_branch=item["target_branch"],
                updated_at=item.get("updated_at", "")[:10],
                web_url=item["web_url"],
                description=item.get("description") or "",
            )
        )
    return merge_requests


def pick(screen, merge_requests, repos):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_CYAN, -1)
    curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
    selected = 0
    top = 0
    while True:
        screen.erase()
        height, width = screen.getmaxyx()
        list_height = max(3, height // 2 - 2)
        header = f" Merge requests to review in {', '.join(project_path(r) for r in repos)}"
        screen.addnstr(0, 0, header, width - 1, curses.A_BOLD)
        screen.addnstr(1, 0, " ↑↓ move   enter open in Zed   o open in browser   q quit   ⇡ stacked on another branch", width - 1, curses.A_DIM)

        if selected < top:
            top = selected
        if selected >= top + list_height:
            top = selected - list_height + 1
        for row, mr in enumerate(merge_requests[top : top + list_height]):
            index = top + row
            indent = "  " * mr.depth + ("└ " if mr.depth else "")
            prefix = f"{indent}!{mr.iid}"
            line = f" {prefix:<9} {mr.title}"
            target = f"⇡ {mr.target_branch}" if mr.stacked else f"→ {mr.target_branch}"
            suffix = f"  {mr.author} · {mr.source_branch} {target} · {mr.updated_at} "
            available = width - 1 - len(suffix)
            line = line[:available].ljust(available) + suffix
            attribute = curses.color_pair(2) if index == selected else curses.A_NORMAL
            screen.addnstr(3 + row, 0, line, width - 1, attribute)

        if merge_requests:
            mr = merge_requests[selected]
            y = 4 + list_height
            screen.hline(y - 1, 0, curses.ACS_HLINE, width)
            screen.addnstr(y, 0, f" {mr.title}", width - 1, curses.color_pair(1) | curses.A_BOLD)
            screen.addnstr(y + 1, 0, f" {mr.web_url}", width - 1, curses.A_DIM)
            y += 3
            for paragraph in mr.description.splitlines() or ["(no description)"]:
                for line in textwrap.wrap(paragraph, width - 2) or [""]:
                    if y >= height - 1:
                        break
                    screen.addnstr(y, 1, line, width - 2)
                    y += 1
        else:
            screen.addnstr(3, 1, "No open merge requests.", width - 2)

        screen.refresh()
        key = screen.getch()
        if key in (curses.KEY_UP, ord("k")):
            selected = max(0, selected - 1)
        elif key in (curses.KEY_DOWN, ord("j")):
            selected = min(len(merge_requests) - 1, selected + 1)
        elif key in (curses.KEY_ENTER, 10, 13) and merge_requests:
            return ("open", merge_requests[selected])
        elif key == ord("o") and merge_requests:
            subprocess.run(["open", merge_requests[selected].web_url])
        elif key in (ord("q"), 27):
            return ("quit", None)


def current_branch(repo):
    result = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=repo, capture_output=True, text=True
    )
    return result.stdout.strip()


def zed_is_running():
    executable = os.path.realpath(os.path.join(ZED_APP, "Contents", "MacOS", "zed"))
    return subprocess.run(["pgrep", "-f", executable], capture_output=True).returncode == 0


def check_out(mr):
    if current_branch(mr.repo) == mr.source_branch:
        # glab refuses to fetch over the checked-out branch, so update it in place.
        pull = subprocess.run(
            ["git", "pull", "--ff-only", "origin", mr.source_branch], cwd=mr.repo
        )
        if pull.returncode != 0:
            sys.exit(f"could not update {mr.source_branch}; is the working tree clean?")
        return
    try:
        checkout = run_glab(["mr", "checkout", str(mr.iid)], mr.repo)
    except RuntimeError as error:
        sys.exit(f"could not check out !{mr.iid}: {error}\nIs the working tree clean?")
    print(checkout.stdout, end="")


def open_in_zed(mr):
    check_out(mr)
    # Diff a stacked merge request against its own base, not the default
    # branch, so only its changes show. Fetch the base so it is current.
    query = {"repo": mr.repo}
    if mr.stacked:
        fetch = subprocess.run(
            ["git", "fetch", "origin", mr.target_branch], cwd=mr.repo, capture_output=True, text=True
        )
        if fetch.returncode != 0:
            print(f"could not fetch {mr.target_branch}: {fetch.stderr.strip()}", file=sys.stderr)
        query["base"] = f"origin/{mr.target_branch}"
    url = "zed://git/review?" + urllib.parse.urlencode(query)
    command = ["open"]
    # A freshly launched app does not inherit the shell's environment, so pass
    # the model key through. A running app keeps the environment it started
    # with, and `open` warns if asked to change it, so skip it then.
    if not zed_is_running():
        for key in ("ANTHROPIC_API_KEY", "OPENAI_API_KEY"):
            if os.environ.get(key):
                command += ["--env", f"{key}={os.environ[key]}"]
    launch = subprocess.run(command + ["-a", ZED_APP, url])
    if launch.returncode != 0:
        sys.exit(f"could not open {ZED_APP}")
    print(f"Opened !{mr.iid} ({mr.source_branch}) in Zed with a suggested review order.")


def main():
    args = sys.argv[1:]
    role = "reviewer"
    if "--assignee" in args:
        role = "assignee"
        args.remove("--assignee")
    if any(arg in ("-h", "--help") for arg in args):
        print(__doc__.strip())
        return
    repos = repositories(args)
    merge_requests = []
    for repo in repos:
        try:
            merge_requests.extend(list_merge_requests(repo, role))
        except (RuntimeError, OSError) as error:
            sys.exit(str(error))
    merge_requests = order_as_stacks(
        merge_requests, {repo: default_branch(repo) for repo in repos}
    )
    action, mr = curses.wrapper(pick, merge_requests, repos)
    if action == "open":
        open_in_zed(mr)


if __name__ == "__main__":
    main()
